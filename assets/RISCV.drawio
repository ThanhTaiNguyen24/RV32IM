0px !important; margin-right: 0px !important;&quot;&gt;&lt;strong style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin: 0px !important;&quot;&gt;Đặc điểm &amp;amp; Lý do phân loại&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;tr style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,1,0,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b data-path-to-node=&quot;3,1,0,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;R-Type&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,1,1,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;code data-path-to-node=&quot;3,1,1,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;add&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,1,1,0&quot; data-index-in-node=&quot;5&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;sub&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,1,1,0&quot; data-index-in-node=&quot;10&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;sll&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,1,1,0&quot; data-index-in-node=&quot;15&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;slt&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,1,1,0&quot; data-index-in-node=&quot;20&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;sltu&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,1,1,0&quot; data-index-in-node=&quot;26&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;xor&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,1,1,0&quot; data-index-in-node=&quot;31&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;srl&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,1,1,0&quot; data-index-in-node=&quot;36&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;sra&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,1,1,0&quot; data-index-in-node=&quot;41&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;or&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,1,1,0&quot; data-index-in-node=&quot;45&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;and&lt;/code&gt;, toàn bộ nhóm &lt;code data-path-to-node=&quot;3,1,1,0&quot; data-index-in-node=&quot;63&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;mul&lt;/code&gt;/&lt;code data-path-to-node=&quot;3,1,1,0&quot; data-index-in-node=&quot;67&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;div&lt;/code&gt;/&lt;code data-path-to-node=&quot;3,1,1,0&quot; data-index-in-node=&quot;71&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;rem&lt;/code&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,1,2,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Lệnh tương tác giữa các thanh ghi. Có đủ 3 trường &lt;code data-path-to-node=&quot;3,1,2,0&quot; data-index-in-node=&quot;50&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;rs1&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,1,2,0&quot; data-index-in-node=&quot;55&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;rs2&lt;/code&gt; và &lt;code data-path-to-node=&quot;3,1,2,0&quot; data-index-in-node=&quot;62&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;rd&lt;/code&gt;. Sử dụng &lt;code data-path-to-node=&quot;3,1,2,0&quot; data-index-in-node=&quot;74&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;funct3&lt;/code&gt; và &lt;code data-path-to-node=&quot;3,1,2,0&quot; data-index-in-node=&quot;84&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;funct7&lt;/code&gt; để xác định phép toán.&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,2,0,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b data-path-to-node=&quot;3,2,0,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;I-Type&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,2,1,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Nhóm &lt;code data-path-to-node=&quot;3,2,1,0&quot; data-index-in-node=&quot;5&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;addi&lt;/code&gt;-&amp;gt;&lt;code data-path-to-node=&quot;3,2,1,0&quot; data-index-in-node=&quot;11&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;srai&lt;/code&gt;, nhóm Load (&lt;code data-path-to-node=&quot;3,2,1,0&quot; data-index-in-node=&quot;28&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;lb&lt;/code&gt;-&amp;gt;&lt;code data-path-to-node=&quot;3,2,1,0&quot; data-index-in-node=&quot;32&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;lhu&lt;/code&gt;), &lt;code data-path-to-node=&quot;3,2,1,0&quot; data-index-in-node=&quot;38&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;jalr&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,2,1,0&quot; data-index-in-node=&quot;44&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;ecall&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,2,1,0&quot; data-index-in-node=&quot;51&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;fence&lt;/code&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,2,2,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Lệnh dùng hằng số (Immediate). Có &lt;code data-path-to-node=&quot;3,2,2,0&quot; data-index-in-node=&quot;34&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;rs1&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,2,2,0&quot; data-index-in-node=&quot;39&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;rd&lt;/code&gt; và một hằng số &lt;code data-path-to-node=&quot;3,2,2,0&quot; data-index-in-node=&quot;57&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;imm[11:0]&lt;/code&gt;. Vị trí bit của &lt;code data-path-to-node=&quot;3,2,2,0&quot; data-index-in-node=&quot;83&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;rs1&lt;/code&gt; và &lt;code data-path-to-node=&quot;3,2,2,0&quot; data-index-in-node=&quot;90&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;rd&lt;/code&gt; nằm y hệt như R-Type để tái sử dụng phần cứng giải mã.&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,3,0,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b data-path-to-node=&quot;3,3,0,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;S-Type&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,3,1,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;code data-path-to-node=&quot;3,3,1,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;sb&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,3,1,0&quot; data-index-in-node=&quot;4&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;sh&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,3,1,0&quot; data-index-in-node=&quot;8&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;sw&lt;/code&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,3,2,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Lệnh lưu dữ liệu vào bộ nhớ. Cần 2 thanh ghi nguồn &lt;code data-path-to-node=&quot;3,3,2,0&quot; data-index-in-node=&quot;51&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;rs1&lt;/code&gt; (địa chỉ nền) và &lt;code data-path-to-node=&quot;3,3,2,0&quot; data-index-in-node=&quot;72&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;rs2&lt;/code&gt; (dữ liệu cần lưu), kết hợp hằng số &lt;code data-path-to-node=&quot;3,3,2,0&quot; data-index-in-node=&quot;111&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;imm[11:0]&lt;/code&gt; bị tách làm hai phần &lt;code data-path-to-node=&quot;3,3,2,0&quot; data-index-in-node=&quot;142&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;[11:5]&lt;/code&gt; và &lt;code data-path-to-node=&quot;3,3,2,0&quot; data-index-in-node=&quot;152&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;[4:0]&lt;/code&gt;. Không có &lt;code data-path-to-node=&quot;3,3,2,0&quot; data-index-in-node=&quot;168&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;rd&lt;/code&gt; vì không ghi lại vào tập thanh ghi.&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,4,0,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b data-path-to-node=&quot;3,4,0,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;B-Type&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,4,1,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;code data-path-to-node=&quot;3,4,1,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;beq&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,4,1,0&quot; data-index-in-node=&quot;5&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;bne&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,4,1,0&quot; data-index-in-node=&quot;10&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;blt&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,4,1,0&quot; data-index-in-node=&quot;15&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;bge&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,4,1,0&quot; data-index-in-node=&quot;20&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;bltu&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,4,1,0&quot; data-index-in-node=&quot;26&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;bgeu&lt;/code&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,4,2,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Lệnh rẽ nhánh có điều kiện. Giống hệt S-Type về cấu trúc thanh ghi (&lt;code data-path-to-node=&quot;3,4,2,0&quot; data-index-in-node=&quot;68&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;rs1&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,4,2,0&quot; data-index-in-node=&quot;73&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;rs2&lt;/code&gt;), nhưng Immediate được xáo trộn bit để tối ưu hóa việc tạo địa chỉ chẵn (dịch trái 1 bit).&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,5,0,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b data-path-to-node=&quot;3,5,0,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;U-Type&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,5,1,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;code data-path-to-node=&quot;3,5,1,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;lui&lt;/code&gt;, &lt;code data-path-to-node=&quot;3,5,1,0&quot; data-index-in-node=&quot;5&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;auipc&lt;/code&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,5,2,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Lệnh thao tác với hằng số lớn. Chỉ có &lt;code data-path-to-node=&quot;3,5,2,0&quot; data-index-in-node=&quot;38&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;rd&lt;/code&gt; và một &lt;code data-path-to-node=&quot;3,5,2,0&quot; data-index-in-node=&quot;48&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;imm[31:12]&lt;/code&gt; (20 bit cao).&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,6,0,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b data-path-to-node=&quot;3,6,0,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;J-Type&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,6,1,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;code data-path-to-node=&quot;3,6,1,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;jal&lt;/code&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,6,2,0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Lệnh nhảy không điều kiện. Có &lt;code data-path-to-node=&quot;3,6,2,0&quot; data-index-in-node=&quot;30&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;rd&lt;/code&gt; (để lưu địa chỉ trả về) và một Immediate 20-bit được xáo trộn để tạo địa chỉ bước nhảy dài.&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="430" width="560" x="850" y="-690" as="geometry" />
        </mxCell>
        <mxCell id="eM1j81Ynzo6OEWQkIbq8-3" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;li&gt;&lt;p data-path-to-node=&quot;1,0,0&quot;&gt;&lt;b data-path-to-node=&quot;1,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Lệnh I-Type (I - Short Immediates &amp;amp; Loads)&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;1,0,1&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;1,0,1,0,0&quot;&gt;&lt;b data-path-to-node=&quot;1,0,1,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Vị trí bit:&lt;/b&gt; Dùng 12 bit liên tục từ phần tử &lt;code data-path-to-node=&quot;1,0,1,0,0&quot; data-index-in-node=&quot;44&quot;&gt;inst_from_imem[31:20]&lt;/code&gt;.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;1,0,1,1,0&quot;&gt;&lt;b data-path-to-node=&quot;1,0,1,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Sign Extension:&lt;/b&gt; Nhân bản bit cao nhất (bit 31 của lệnh, tức là &lt;code data-path-to-node=&quot;1,0,1,1,0&quot; data-index-in-node=&quot;63&quot;&gt;imm_i[11]&lt;/code&gt;) thêm 20 lần và ghép vào phía trước để tạo thành số 32-bit hoàn chỉnh: &lt;code data-path-to-node=&quot;1,0,1,1,0&quot; data-index-in-node=&quot;144&quot;&gt;{{20{imm_i[11]}}, imm_i[11:0]}&lt;/code&gt;.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;1,1,0&quot;&gt;&lt;b data-path-to-node=&quot;1,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Lệnh S-Type (S - Stores)&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;1,1,1&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;1,1,1,0,0&quot;&gt;&lt;b data-path-to-node=&quot;1,1,1,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Vị trí bit:&lt;/b&gt; Được ghép từ hai trường không liền kề nhau của lệnh: 7 bit từ &lt;code data-path-to-node=&quot;1,1,1,0,0&quot; data-index-in-node=&quot;74&quot;&gt;inst_funct7&lt;/code&gt; (&lt;code data-path-to-node=&quot;1,1,1,0,0&quot; data-index-in-node=&quot;87&quot;&gt;inst[31:25]&lt;/code&gt;) làm các bit cao và 5 bit từ &lt;code data-path-to-node=&quot;1,1,1,0,0&quot; data-index-in-node=&quot;128&quot;&gt;inst_rd&lt;/code&gt; (&lt;code data-path-to-node=&quot;1,1,1,0,0&quot; data-index-in-node=&quot;137&quot;&gt;inst[11:7]&lt;/code&gt;) làm các bit thấp.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;1,1,1,1,0&quot;&gt;&lt;b data-path-to-node=&quot;1,1,1,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Sign Extension:&lt;/b&gt; Nhân bản bit dấu (bit 31 của lệnh, tương ứng &lt;code data-path-to-node=&quot;1,1,1,1,0&quot; data-index-in-node=&quot;61&quot;&gt;imm_s[11]&lt;/code&gt;) thêm 20 lần: &lt;code data-path-to-node=&quot;1,1,1,1,0&quot; data-index-in-node=&quot;85&quot;&gt;{{20{imm_s[11]}}, imm_s[11:0]}&lt;/code&gt;.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;1,2,0&quot;&gt;&lt;b data-path-to-node=&quot;1,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Lệnh B-Type (B - Conditionals)&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;1,2,1&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;1,2,1,0,0&quot;&gt;&lt;b data-path-to-node=&quot;1,2,1,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Vị trí bit:&lt;/b&gt; Lấy từ &lt;code data-path-to-node=&quot;1,2,1,0,0&quot; data-index-in-node=&quot;19&quot;&gt;inst_funct7&lt;/code&gt; và &lt;code data-path-to-node=&quot;1,2,1,0,0&quot; data-index-in-node=&quot;34&quot;&gt;inst_rd&lt;/code&gt; tương tự S-Type nhưng xáo trộn vị trí để tạo địa chỉ chẵn (bit 0 mặc định là &lt;code data-path-to-node=&quot;1,2,1,0,0&quot; data-index-in-node=&quot;119&quot;&gt;0&lt;/code&gt;). Cụ thể: &lt;code data-path-to-node=&quot;1,2,1,0,0&quot; data-index-in-node=&quot;131&quot;&gt;inst[31]&lt;/code&gt; làm bit 12, &lt;code data-path-to-node=&quot;1,2,1,0,0&quot; data-index-in-node=&quot;152&quot;&gt;inst[7]&lt;/code&gt; làm bit 11, &lt;code data-path-to-node=&quot;1,2,1,0,0&quot; data-index-in-node=&quot;172&quot;&gt;inst[30:25]&lt;/code&gt; làm dải bit 10:1, &lt;code data-path-to-node=&quot;1,2,1,0,0&quot; data-index-in-node=&quot;202&quot;&gt;inst[11:8]&lt;/code&gt; làm dải bit 4:1.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;1,2,1,1,0&quot;&gt;&lt;b data-path-to-node=&quot;1,2,1,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Sign Extension:&lt;/b&gt; Nhân bản bit dấu (bit 31 của lệnh, tức &lt;code data-path-to-node=&quot;1,2,1,1,0&quot; data-index-in-node=&quot;55&quot;&gt;imm_b[12]&lt;/code&gt;) thêm 19 lần do giá trị hằng số lúc này đã chiếm 13 bit: &lt;code data-path-to-node=&quot;1,2,1,1,0&quot; data-index-in-node=&quot;122&quot;&gt;{{19{imm_b[12]}}, imm_b[12:0]}&lt;/code&gt;.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;1,3,0&quot;&gt;&lt;b data-path-to-node=&quot;1,3,0&quot; data-index-in-node=&quot;0&quot;&gt;Lệnh J-Type (J - Unconditional Jumps)&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;1,3,1&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;1,3,1,0,0&quot;&gt;&lt;b data-path-to-node=&quot;1,3,1,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Vị trí bit:&lt;/b&gt; Sử dụng dải 20 bit từ &lt;code data-path-to-node=&quot;1,3,1,0,0&quot; data-index-in-node=&quot;34&quot;&gt;inst_from_imem[31:12]&lt;/code&gt; và xáo trộn vị trí: &lt;code data-path-to-node=&quot;1,3,1,0,0&quot; data-index-in-node=&quot;76&quot;&gt;inst[31]&lt;/code&gt; làm bit 20, &lt;code data-path-to-node=&quot;1,3,1,0,0&quot; data-index-in-node=&quot;97&quot;&gt;inst[19:12]&lt;/code&gt; làm dải bit 19:12, &lt;code data-path-to-node=&quot;1,3,1,0,0&quot; data-index-in-node=&quot;128&quot;&gt;inst[20]&lt;/code&gt; làm bit 11, &lt;code data-path-to-node=&quot;1,3,1,0,0&quot; data-index-in-node=&quot;149&quot;&gt;inst[30:21]&lt;/code&gt; làm dải bit 10:1, và gán cứng bit 0 bằng &lt;code data-path-to-node=&quot;1,3,1,0,0&quot; data-index-in-node=&quot;202&quot;&gt;0&lt;/code&gt;.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;1,3,1,1,0&quot;&gt;&lt;b data-path-to-node=&quot;1,3,1,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Sign Extension:&lt;/b&gt; Nhân bản bit dấu (bit 31 của lệnh, tức &lt;code data-path-to-node=&quot;1,3,1,1,0&quot; data-index-in-node=&quot;55&quot;&gt;imm_j[20]&lt;/code&gt;) thêm 11 lần do hằng số này có độ rộng 21 bit: &lt;code data-path-to-node=&quot;1,3,1,1,0&quot; data-index-in-node=&quot;112&quot;&gt;{{11{imm_j[20]}}, imm_j[20:0]}&lt;/code&gt;.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;1,4,0&quot;&gt;&lt;b data-path-to-node=&quot;1,4,0&quot; data-index-in-node=&quot;0&quot;&gt;Lệnh U-Type (U - Upper Immediates)&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;1,4,1&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;1,4,1,0,0&quot;&gt;&lt;b data-path-to-node=&quot;1,4,1,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Vị trí bit:&lt;/b&gt; Lấy nguyên khối 20 bit cao nhất của lệnh từ &lt;code data-path-to-node=&quot;1,4,1,0,0&quot; data-index-in-node=&quot;56&quot;&gt;inst_from_imem[31:12]&lt;/code&gt;.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;1,4,1,1,0&quot;&gt;&lt;b data-path-to-node=&quot;1,4,1,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Sign Extension:&lt;/b&gt; Bản chất là dịch trái logic (zero-padding), chèn thêm 12 bit &lt;code data-path-to-node=&quot;1,4,1,1,0&quot; data-index-in-node=&quot;77&quot;&gt;0&lt;/code&gt; vào các vị trí thấp nhất để điền đầy 32 bit: &lt;code data-path-to-node=&quot;1,4,1,1,0&quot; data-index-in-node=&quot;124&quot;&gt;{inst_from_imem[31:12], 12&#39;b0}&lt;/code&gt;.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="760" width="750" x="50" y="-710" as="geometry" />
        </mxCell>
